{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinderm/office-intelligence/main/skills/cloud-atlas/references/filemap.schema.json",
  "title": "Cloud Atlas Filemap Container",
  "description": "A filemap is an inventory container. It is not itself a data-zone-artifact. Canonical cloud artifact metadata is carried per mirrored file in artifact_metadata and is delegated to the normative data-zone-artifact schema.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "scope",
    "storage_id",
    "project",
    "project_title",
    "scan_dir",
    "output_dir",
    "updated_at",
    "files"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/martinderm/office-intelligence/main/skills/cloud-atlas/references/filemap.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "cloud-filemap"
    },
    "scope": {
      "enum": ["project", "topic"]
    },
    "storage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "scan_dir": {
      "$ref": "#/$defs/workspace_relative_path"
    },
    "output_dir": {
      "$ref": "#/$defs/workspace_relative_path"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/workspace_relative_path"
      },
      "additionalProperties": {
        "$ref": "#/$defs/file_entry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "workspace_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "file_entry": {
      "type": "object",
      "description": "Source inventory metadata plus optional canonical metadata for its local Markdown mirror.",
      "required": [
        "version",
        "mtime",
        "size",
        "sha256",
        "description"
      ],
      "properties": {
        "version": {"type": "string"},
        "mtime": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
        },
        "size": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)? (?:B|KB|MB)$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "description": {"type": "string"},
        "markdown_mirror": {"$ref": "#/$defs/workspace_relative_path"},
        "derivative": {
          "type": "object",
          "required": ["path", "sha256", "format"],
          "properties": {
            "path": {"$ref": "#/$defs/workspace_relative_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "format": {"type": "string", "minLength": 1},
            "conversion_method": {"type": "string", "minLength": 1},
            "converted_at": {"type": "string", "minLength": 1},
            "potential_quality_loss": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "conversion_status": {
          "enum": ["converted", "conversion_required"]
        },
        "conversion_error": {"type": "string"},
        "ocr_applied": {"type": "boolean"},
        "ocr_policy": {
          "enum": ["enrich_source", "local_derivative", "disabled"]
        },
        "artifact_metadata": {
          "$ref": "https://github.com/martinderm/agent-architecture/schemas/data-zone-artifact.schema.json"
        }
      },
      "additionalProperties": true
    }
  }
}

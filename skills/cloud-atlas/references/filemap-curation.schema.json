{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/martinderm/office-intelligence/main/skills/cloud-atlas/references/filemap-curation.schema.json",
  "title": "Cloud Atlas Filemap Curation Overlay",
  "type": "object",
  "required": ["$schema", "schema_version", "kind", "scope", "target", "storage_id", "source_receipt", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/martinderm/office-intelligence/main/skills/cloud-atlas/references/filemap-curation.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "cloud-filemap-curation"},
    "scope": {"enum": ["project", "topic", "subtopic"]},
    "target": {"type": "object"},
    "storage_id": {"type": "string", "minLength": 1},
    "source_receipt": {
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "file_count": {"type": "integer", "minimum": 0},
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "additionalProperties": {"$ref": "#/$defs/entry"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "subtopic"}}},
      "then": {"properties": {"target": {"$ref": "#/$defs/subtopic_target"}}},
      "else": {"properties": {"target": {"$ref": "#/$defs/id_target"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "id_target": {
      "type": "object", "required": ["id"], "additionalProperties": false,
      "properties": {"id": {"type": "string", "minLength": 1}}
    },
    "subtopic_target": {
      "type": "object", "required": ["topic_id", "subtopic_id"], "additionalProperties": false,
      "properties": {
        "topic_id": {"type": "string", "minLength": 1},
        "subtopic_id": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "description": {"type": "string"},
        "custom": {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {"minLength": 1},
              {"not": {"enum": ["version", "mtime", "size", "sha256", "markdown_mirror", "derivative", "conversion_status", "conversion_error", "ocr_applied", "ocr_policy", "artifact_metadata", "description", "source_sha256"]}}
            ]
          },
          "additionalProperties": true
        }
      }
    }
  }
}
